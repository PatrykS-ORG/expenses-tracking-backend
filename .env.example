# Mailing
MAIL_SENDER=
MAIL_SENDER_NAME=
BREVO_API_KEY=
BREVO_BASE_URL=

# AI
DEEPSEEK_API_KEY=
# Optional: tokens-to-credits ratio and default monthly limit for new users
AI_TOKENS_PER_CREDIT=1000
AI_MONTHLY_CREDIT_LIMIT=50
# Optional: model override used for receipt text extraction (defaults to deepseek-chat)
DEEPSEEK_VISION_MODEL=
# Optional: Tesseract language(s) for receipt OCR (defaults to eng+pol)
RECEIPT_OCR_LANG=eng+pol
# Optional: Tesseract page segmentation mode override for receipt OCR (defaults to
# "4" / SINGLE_COLUMN — receipts are narrow single-column strips of text; PSM.AUTO
# tends to split the item-name column and the price column into separate blocks)
RECEIPT_OCR_PSM=

# DB
DATABASE_URL=
DIRECT_URL=

# Set to true if your DB uses a trusted CA chain. Keep false for self-signed certs.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL=
# Legacy HS256 only — not used when SUPABASE_URL is set and JWKS is available
SUPABASE_JWT_SECRET=
# OAuth providers (including Google OAuth 2.0) are configured in Supabase Auth.
# Backend only validates Supabase-issued access tokens; no Google callback/login vars are needed here.
# Service role key required for backend uploads/downloads from Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Cron webhook
CRON_SECRET=
