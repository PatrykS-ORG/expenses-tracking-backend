# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- Supabase PostgreSQL (Prisma) ---
# Pooled connection URL (runtime queries)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (migrations) — required for prisma migrate
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Set to true if your DB uses a trusted CA chain. Keep false for self-signed certs.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Supabase Auth (JWT verification) ---
# Required for asymmetric signing (ES256 / JWKS) — default on new Supabase projects
SUPABASE_URL=https://your-project.supabase.co
# Legacy HS256 only — not used when SUPABASE_URL is set and JWKS is available
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Service role key required for backend uploads/downloads from Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=expenses

# --- AI (DeepSeek) ---
DEEPSEEK_API_KEY=

# --- Email (Brevo API) ---
BREVO_API_KEY=
MAIL_SENDER=noreply@example.com
MAIL_SENDER_NAME=ExpenseAI
BREVO_BASE_URL=https://api.brevo.com/v3

# --- Nextcloud WebDAV (shared server credentials) ---
NEXTCLOUD_WEBDAV_URL=https://nextcloud.example.com/remote.php/dav/files/<shared-user>
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# --- Cron webhook ---
CRON_SECRET=generate-a-long-random-secret
